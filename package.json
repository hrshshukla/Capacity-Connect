{
  "name": "capacity-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "PORT=5001 NODE_ENV=development npm run server:build && PORT=5001 NODE_ENV=development node server/dist/index.mjs",
    "dev:client": "PORT=5000 BASE_PATH=/ vite --config client/vite.config.ts --host 0.0.0.0",
    "build": "npm run typecheck && npm run client:build && npm run server:build",
    "client:build": "vite build --config client/vite.config.ts",
    "server:build": "node server/build.mjs",
    "start": "npm run build && NODE_ENV=production PORT=${PORT:-5000} node server/dist/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "codegen": "orval --config ./shared/api-spec/orval.config.ts && npm run typecheck",
    "hello": "tsx ./scripts/src/hello.ts",
    "db:push": "drizzle-kit push --config ./db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./db/drizzle.config.ts",
    "db:seed": "tsx ./db/src/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
