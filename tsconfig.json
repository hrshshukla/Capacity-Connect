{
  "extends": "./tsconfig.base.json",
  "compileOnSave": false,
  "files": [],
  "include": ["client/src", "server/src", "db/src", "shared", "scripts/src"],
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
